# Backend Environment Variables
# Copy this file to .env and replace with your own values.

# Database Configuration (PostgreSQL)
# For local dev, use DB_URL=jdbc:postgresql://localhost:5432/scard
DB_URL=jdbc:postgresql://localhost:5432/scard
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub Token for syncing contributions (Needs public_repo scope)
GH_TOKEN=your_github_personal_access_token_here

# Server Configuration
PORT=8080