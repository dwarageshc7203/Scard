# Build stage
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Serve stage
FROM nginx:alpine
# Copy the built Vite output to Nginx's web root
COPY --from=build /app/dist /usr/share/nginx/html
# Copy the deploy nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Adjust the configuration for the Docker environment and non-root execution
RUN sed -i 's|/var/www/scard/frontend/dist|/usr/share/nginx/html|g' /etc/nginx/conf.d/default.conf && \
    sed -i 's|localhost:8080|backend:8080|g' /etc/nginx/conf.d/default.conf && \
    sed -i 's|listen 80;|listen 8080;|g' /etc/nginx/conf.d/default.conf && \
    sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf

# Give nginx user permissions to directories
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html /tmp

# Run as non-root user
USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
